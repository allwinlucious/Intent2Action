+#include "intrinsic/eigenmath/so3.h"
+
+#include <gmock/gmock.h>
+#include <gtest/gtest.h>
+
+#include "Eigen/Geometry"
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
+#include "intrinsic/eigenmath/types.h"
+#include "intrinsic/icon/utils/realtime_status_or.h"
+
+namespace intrinsic {
+namespace eigenmath {
+namespace {
+
+using ::testing::HasSubstr;
+
+// -P for the cyclic permutation matrix P. Eigen converts this reflection into
+// a unit quaternion, so it slips past a pure normalization check.
+Matrix3d NegatedCyclicPermutation() {
+  Matrix3d matrix;
+  matrix << 0, 0, -1, -1, 0, 0, 0, -1, 0;
+  return matrix;
+}
+
+Matrix3d ProperRotation() {
+  return Eigen::AngleAxisd(0.7, Vector3d(1, 2, 3).normalized())
+      .toRotationMatrix();
+}
+
+class SO3FromMatrixReflectionTest : public ::testing::TestWithParam<Matrix3d> {
+};
+
+TEST_P(SO3FromMatrixReflectionTest, FromMatrixRejectsReflection) {
+  for (const bool do_orthogonalize : {true, false}) {
+    const absl::StatusOr<SO3d> rotation =
+        SO3d::FromMatrix(GetParam(), do_orthogonalize);
+    ASSERT_FALSE(rotation.ok()) << "do_orthogonalize=" << do_orthogonalize;
+    EXPECT_EQ(rotation.status().code(), absl::StatusCode::kInvalidArgument);
+    EXPECT_THAT(rotation.status().message(), HasSubstr("reflection"));
+  }
+}
+
+TEST_P(SO3FromMatrixReflectionTest, FromMatrixRealtimeSafeRejectsReflection) {
+  for (const bool do_orthogonalize : {true, false}) {
+    const icon::RealtimeStatusOr<SO3d> rotation =
+        SO3d::FromMatrixRealtimeSafe(GetParam(), do_orthogonalize);
+    ASSERT_FALSE(rotation.ok()) << "do_orthogonalize=" << do_orthogonalize;
+    EXPECT_EQ(rotation.status().code(), absl::StatusCode::kInvalidArgument);
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    Reflections, SO3FromMatrixReflectionTest,
+    ::testing::Values(
+        NegatedCyclicPermutation(), Matrix3d(Vector3d(-1, 1, 1).asDiagonal()),
+        Matrix3d(-Matrix3d::Identity()), Matrix3d(-ProperRotation()),
+        Matrix3d(ProperRotation() * Vector3d(1, 1, -1).asDiagonal())));
+
+TEST(SO3FromMatrixTest, FromMatrixAcceptsProperRotation) {
+  for (const bool do_orthogonalize : {true, false}) {
+    const absl::StatusOr<SO3d> rotation =
+        SO3d::FromMatrix(ProperRotation(), do_orthogonalize);
+    ASSERT_TRUE(rotation.ok()) << rotation.status();
+    EXPECT_TRUE(rotation->matrix().isApprox(ProperRotation(), 1e-12));
+
+    const icon::RealtimeStatusOr<SO3d> realtime_rotation =
+        SO3d::FromMatrixRealtimeSafe(ProperRotation(), do_orthogonalize);
+    ASSERT_TRUE(realtime_rotation.ok()) << realtime_rotation.status();
+    EXPECT_TRUE(
+        (*realtime_rotation).matrix().isApprox(ProperRotation(), 1e-12));
+  }
+}
+
+TEST(SO3FromMatrixTest, FromMatrixOrthogonalizesNoisyRotation) {
+  Matrix3d noisy = ProperRotation();
+  noisy(0, 1) += 1e-4;
+  const absl::StatusOr<SO3d> rotation = SO3d::FromMatrix(noisy);
+  ASSERT_TRUE(rotation.ok()) << rotation.status();
+  EXPECT_TRUE(rotation->matrix().isApprox(ProperRotation(), 1e-3));
+}
+
+}  // namespace
+}  // namespace eigenmath
+}  // namespace intrinsic
